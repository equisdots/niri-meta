#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# equisdots-niri · dotsniri
#
# Meta installer and updater for the equisdots niri desktop stack. This is a
# thin entry point: it resolves its own location, sources the lib/ modules,
# parses the global flags and dispatches to the command implementations.
#
# The whole implementation is sourced up front on purpose. A run may pull the
# niri-meta clone (self-update) while executing; because the functions are
# already in memory, rewriting the files on disk cannot corrupt this process.
#
# Usage: dotsniri <command> [-y] [--dry-run]
#   Run `dotsniri help` for the full command surface.
# ═══════════════════════════════════════════════════════════════════════════
set -euo pipefail

# Resolve the real path of this script, following symlinks (a wrapper in
# ~/.local/bin may point at the clone).
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
    SELF="$(readlink "$SELF")"
done
ROOT_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
export ROOT_DIR

# Remote bootstrap: when this file is piped from curl (`bash <(curl ...)`) there
# is no lib/ next to it, so clone the meta and hand over to the clone's entry
# point. From a local checkout or the installed wrapper this is a no-op.
#
# Limitation: this script cannot install packages before it has a checkout.
# It therefore needs git, or at least curl/wget + tar, to fetch the meta. Once
# the checkout exists, the normal preflight runs the system phase and installs
# the missing runtime tools (git/rsync/jq) on a supported distro.
if [[ ! -r "$ROOT_DIR/lib/common.sh" ]]; then
    __base="${XDG_DATA_HOME:-$HOME/.local/share}/equisdots-niri"
    __target="$__base/niri-meta"
    __have() { command -v "$1" >/dev/null 2>&1; }
    __tar_url="https://github.com/equisdots/niri-meta/archive/refs/heads/main.tar.gz"
    __ok=0

    if [[ -d "$__target/.git" ]]; then
        # Keep the bootstrap clone current. The one-liner otherwise re-runs a
        # stale checkout (the installed wrapper does not self-update either).
        if __have git; then
            git -C "$__target" fetch --depth 1 origin main --quiet 2>/dev/null \
                && git -C "$__target" reset --hard FETCH_HEAD --quiet 2>/dev/null \
                || true
        fi
        __ok=1
    elif __have git && [[ ! -e "$__target" ]]; then
        printf ':: bootstrapping niri-meta into %s\n' "$__target"
        mkdir -p "$__base"
        if git clone --depth 1 https://github.com/equisdots/niri-meta.git \
            "$__target" --quiet; then
            __ok=1
        else
            printf ':: git clone failed; trying the source tarball\n' >&2
        fi
    fi

    # Fallback for a git-less bootstrap (curl/wget + tar only). A later
    # `dotsniri install` parks this plain copy and replaces it with a real
    # git clone via the normal repo registry.
    if [[ "$__ok" -eq 0 ]]; then
        __tmp="$(mktemp -d)"
        if __have curl; then
            if ! curl -fsSL "$__tar_url" -o "$__tmp/meta.tar.gz"; then
                rm -rf "$__tmp"
                printf 'error: could not download the niri-meta tarball (network?)\n' >&2
                exit 1
            fi
        elif __have wget; then
            if ! wget -qO "$__tmp/meta.tar.gz" "$__tar_url"; then
                rm -rf "$__tmp"
                printf 'error: could not download the niri-meta tarball (network?)\n' >&2
                exit 1
            fi
        else
            printf 'error: bootstrap needs git, or curl/wget + tar; install git and re-run\n' >&2
            exit 1
        fi
        if ! __have tar; then
            rm -rf "$__tmp"
            printf 'error: bootstrap needs tar to unpack the meta; install tar and re-run\n' >&2
            exit 1
        fi
        printf ':: bootstrapping niri-meta from the source tarball into %s\n' "$__target"
        mkdir -p "$__target"
        if ! tar -xzf "$__tmp/meta.tar.gz" -C "$__target" --strip-components=1; then
            rm -rf "$__tmp"
            printf 'error: could not unpack the niri-meta tarball\n' >&2
            exit 1
        fi
        rm -rf "$__tmp"
    fi

    exec "$__target/bin/dotsniri" "$@"
fi

# shellcheck source=../lib/common.sh
. "$ROOT_DIR/lib/common.sh"
# shellcheck source=../lib/repos.sh
. "$ROOT_DIR/lib/repos.sh"
# shellcheck source=../lib/deploy.sh
. "$ROOT_DIR/lib/deploy.sh"
# shellcheck source=../lib/desktop.sh
. "$ROOT_DIR/lib/desktop.sh"
# shellcheck source=../lib/login.sh
. "$ROOT_DIR/lib/login.sh"
# shellcheck source=../lib/doctor.sh
. "$ROOT_DIR/lib/doctor.sh"
# shellcheck source=../lib/xwww.sh
. "$ROOT_DIR/lib/xwww.sh"
# shellcheck source=../lib/system.sh
. "$ROOT_DIR/lib/system.sh"
# shellcheck source=../lib/plugins.sh
. "$ROOT_DIR/lib/plugins.sh"

main() {
    local rest=() arg
    for arg in "$@"; do
        case "$arg" in
            -y|--yes)       ASSUME_YES=1 ;;
            -n|--dry-run)   DRY_RUN=1 ;;
            -h|--help)      HELP=1 ;;
            --version)      rest+=(version) ;;
            *)              rest+=("$arg") ;;
        esac
    done
    set -- "${rest[@]}"

    local cmd="${1:-help}"
    if [[ "${HELP:-0}" -eq 1 ]]; then
        usage_command "$cmd"
        return 0
    fi

    case "$cmd" in
        setup)      shift; cmd_setup "$@" ;;
        list)       shift; cmd_list "$@" ;;
        update)     shift; cmd_update "$@" ;;
        install)    shift; cmd_install "$@" ;;
        deploy)     shift; cmd_deploy "$@" ;;
        doctor)     shift; cmd_doctor "$@" ;;
        --self-test) cmd_doctor_selftest ;;
        reset)      shift; cmd_reset "$@" ;;
        uninstall)  shift; cmd_uninstall "$@" ;;
        desktop)    shift; cmd_desktop "$@" ;;
        login)      shift; cmd_login "$@" ;;
        system)     shift; cmd_system "$@" ;;
        xwww)       shift; cmd_xwww "$@" ;;
        plugins)    shift; cmd_plugins "$@" ;;
        version)    cmd_version ;;
        help)       usage ;;
        *)          usage; die "unknown command: $cmd" ;;
    esac
}

main "$@"
